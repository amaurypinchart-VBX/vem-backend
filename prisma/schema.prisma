generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  project_manager
  site_manager
  technical_manager
  engineer
  worker
  client
  warehouse
  sales_engineer
  installer
}

enum ProjectStatus {
  draft
  confirmed
  quote_to_validate
  quote_validated
  in_preparation
  loading
  on_site
  installation
  handover
  handover_ok
  dismantling
  completed
  cancelled
}

enum TaskStatus {
  todo
  in_progress
  done
  blocked
  cancelled
}

enum Priority {
  low
  normal
  high
  critical
}

enum TicketStatus {
  open
  assigned
  in_progress
  resolved
  validated
  closed
}

enum TicketUrgency {
  low
  medium
  high
  critical
}

enum BoxStatus {
  preparing
  ready
  loaded
  on_site
  returned
  incomplete
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  role         UserRole  @default(worker)
  avatarUrl    String?   @map("avatar_url")
  birthDate      String?  @map("birth_date")
  birthPlace     String?  @map("birth_place")
  nationality    String?
  idNumber       String?  @map("id_number")
  nationalNumber String?  @map("national_number")
  idExpiry       String?  @map("id_expiry")
  teamGroupId    String?  @map("team_group_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  pushToken    String?   @map("push_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  managedProjects     Project[]      @relation("TechnicalManager")
  createdProjects     Project[]      @relation("CreatedBy")
  projectTeam         ProjectTeam[]
  assignedTasks       Task[]         @relation("AssignedTo")
  createdTasks        Task[]         @relation("TaskCreatedBy")
  taskComments        TaskComment[]
  handovers           Handover[]     @relation("HandoverCreatedBy")
  siteManagerHandover Handover[]     @relation("SiteManager")
  createdPlan2Ds      Plan2D[]       @relation("Plan2DCreatedBy")
  createdPlansModels  PlansModelVersion[] @relation("PlansModelCreatedBy")
  dailyReports        DailyReport[]
  reportedTickets     Ticket[]       @relation("ReportedBy")
  assignedTickets     Ticket[]       @relation("TicketAssignedTo")
  validatedTickets    Ticket[]       @relation("ValidatedBy")
  preparedBoxes       WarehouseBox[] @relation("BoxPreparedBy")
  validatedBoxes      WarehouseBox[] @relation("BoxValidatedBy")
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  assignedRemarks     ClientRemark[] @relation("RemarkAssignee")
  teamBookings        TeamBooking[]
  hotelOccupations    HotelBookingOccupant[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Client {
  id          String    @id @default(uuid())
  name        String
  vat         String?
  contactName String?   @map("contact_name")
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  projects    Project[]
  clientVisits ClientVisit[]
  contacts    ClientContact[]

  @@map("clients")
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  email       String?
  phone       String?
  notes       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("client_contacts")
}

// Settings globaux de l'application (key/value JSON).
// Stocke par exemple le logo par défaut des briefings sous la clé "briefing-default-logo".
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Project {
  id                  String        @id @default(uuid())
  internalNumber      String        @unique @map("internal_number")
  name                String
  clientId            String        @map("client_id")
  status              ProjectStatus @default(draft)
  address             String
  city                String?
  installationStart   DateTime      @map("installation_start")
  installationEnd     DateTime      @map("installation_end")
  dismantlingStart    DateTime?     @map("dismantling_start")
  dismantlingEnd      DateTime?     @map("dismantling_end")
  workersCount        Int           @default(0) @map("workers_count")
  description         String?
  specialInstructions String?       @map("special_instructions")
  // Notes complémentaires (saisies depuis Infos projet)
  scope               String?       // Notes globales / objet du projet
  installNotes        String?       @map("install_notes")    // Notes spécifiques à l'installation
  dismantleNotes      String?       @map("dismantle_notes")  // Notes spécifiques au démontage
  // Ordre d'affichage dans le calendrier Gantt (drag-and-drop par l'utilisateur)
  sortOrder           Int           @default(0) @map("sort_order")
  technicalManagerId  String?       @map("technical_manager_id")
  createdById         String?       @map("created_by")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  client           Client         @relation(fields: [clientId], references: [id])
  technicalManager User?          @relation("TechnicalManager", fields: [technicalManagerId], references: [id])
  createdBy        User?          @relation("CreatedBy", fields: [createdById], references: [id])
  team             ProjectTeam[]
  trucks           Truck[]
  files            ProjectFile[]
  tasks            Task[]
  handovers        Handover[]
  dailyReports     DailyReport[]
  tickets          Ticket[]
  warehouseBoxes   WarehouseBox[]
  toolboxes        Toolbox[]
  clientRemarks    ClientRemark[]
  clientVisits     ClientVisit[]
  briefing         Briefing[]
  teamBookings     TeamBooking[]
  hotelBookings    HotelBooking[]
  plan2Ds          Plan2D[]
  plansModels      PlansModelVersion[]

  @@map("projects")
}

// Booking de transport pour un membre d'équipe sur un projet.
// Un booking = un membre, une phase (installation OU démontage), avec trajets
// aller et retour. Les hôtels sont gérés séparément (modèle HotelBooking)
// car ils sont souvent partagés entre plusieurs membres.
model TeamBooking {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  userId          String    @map("user_id")
  phase           String    // 'installation' | 'dismantling'

  // Présence effective sur le chantier
  onSiteStart     DateTime  @map("on_site_start")
  onSiteEnd       DateTime  @map("on_site_end")

  // Trajet aller (vers le chantier)
  outboundMode    String?   @map("outbound_mode")
  outboundDate    DateTime? @map("outbound_date")
  outboundDetails String?   @map("outbound_details")

  // Trajet retour (depuis le chantier)
  returnMode      String?   @map("return_mode")
  returnDate      DateTime? @map("return_date")
  returnDetails   String?   @map("return_details")

  notes           String?
  // Pièce jointe (PDF / image) — confirmation, billet, voucher...
  attachmentUrl      String?  @map("attachment_url")
  attachmentName     String?  @map("attachment_name")
  attachmentPublicId String?  @map("attachment_public_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("team_bookings")
}

// Réservation d'hôtel — séparée des bookings transport car typiquement
// partagée entre plusieurs membres (chambre double, équipe entière, etc.).
// Un occupant = un membre lié à cette réservation via HotelBookingOccupant.
model HotelBooking {
  id           String                  @id @default(uuid())
  projectId    String                  @map("project_id")
  phase        String                  // 'installation' | 'dismantling'
  hotelName    String                  @map("hotel_name")
  hotelAddress String?                 @map("hotel_address")
  checkin      DateTime
  checkout     DateTime
  reference    String?                 // n° de réservation
  notes        String?
  // Pièce jointe (PDF / image) — voucher, confirmation hôtel...
  attachmentUrl      String?            @map("attachment_url")
  attachmentName     String?            @map("attachment_name")
  attachmentPublicId String?            @map("attachment_public_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  occupants    HotelBookingOccupant[]

  @@map("hotel_bookings")
}

// Lien N-N : un hôtel a plusieurs occupants, un membre peut être dans
// plusieurs hôtels (différentes phases ou nuits dispatchées).
model HotelBookingOccupant {
  id             String       @id @default(uuid())
  hotelBookingId String       @map("hotel_booking_id")
  userId         String       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  hotelBooking   HotelBooking @relation(fields: [hotelBookingId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hotelBookingId, userId])
  @@map("hotel_booking_occupants")
}

model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String
  isLead    Boolean  @default(false) @map("is_lead")
  // Phase du projet sur laquelle ce membre intervient :
  // 'installation' = uniquement à l'install, 'dismantling' = uniquement au démontage, 'both' = les deux.
  phase     String   @default("both")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_team")
}

model Truck {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  truckNumber   String?   @map("truck_number")
  licensePlate  String?   @map("license_plate")
  driverName    String?   @map("driver_name")
  driverPhone   String?   @map("driver_phone")
  vehicleType   String?   @map("vehicle_type") @default("truck")
  loadingDate   DateTime? @map("loading_date")
  departureDate DateTime? @map("departure_date")
  arrivalDate   DateTime? @map("arrival_date")
  notes         String?
  status        String    @default("planned")
  loadingLocation   String? @map("loading_location")
  unloadingLocation String? @map("unloading_location")
  warehouseTaskId   String? @map("warehouse_task_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("trucks")
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  uploadedBy String?  @map("uploaded_by")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  publicId   String?  @map("public_id")
  fileType   String?  @map("file_type")
  fileSize   Int?     @map("file_size")
  category   String   @default("general")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_files")
}

model Task {
  id             String     @id @default(uuid())
  projectId      String     @map("project_id")
  title          String
  description    String?
  stage          String?    // catégorie/étape (template) — préserve l'arborescence
  taskDate       DateTime?  @map("task_date")
  startTime      String?    @map("start_time")
  endTime        String?    @map("end_time")
  status         TaskStatus @default(todo)
  priority       Priority   @default(normal)
  assignedToId   String?    @map("assigned_to")
  createdById    String?    @map("created_by")
  estimatedHours Float?     @map("estimated_hours")
  actualHours    Float?     @map("actual_hours")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy  User?         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  photos     TaskPhoto[]
  comments   TaskComment[]

  @@map("tasks")
}

model TaskPhoto {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  uploadedBy String?  @map("uploaded_by")
  photoUrl   String   @map("photo_url")
  publicId   String?  @map("public_id")
  caption    String?
  createdAt  DateTime @default(now()) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_photos")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  userId    String?  @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

model Handover {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  createdById         String?   @map("created_by")
  clientName          String?   @map("client_name")
  clientEmail         String?   @map("client_email")
  clientSignatureUrl  String?   @map("client_signature_url")
  clientSignedAt      DateTime? @map("client_signed_at")
  managerSignatureUrl String?   @map("manager_signature_url")
  managerSignedAt     DateTime? @map("manager_signed_at")
  siteManagerId       String?   @map("site_manager_id")
  status              String    @default("draft")
  pdfUrl              String?   @map("pdf_url")
  generalNotes        String?   @map("general_notes")
  scopeOfWork          String?   @map("scope_of_work")
  customFields         Json?     @map("custom_fields")
  signatureToken          String?   @map("signature_token")
  signatureTokenUsed      Boolean   @default(false) @map("signature_token_used")
  signatureTokenCreatedAt DateTime? @map("signature_token_created_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("HandoverCreatedBy", fields: [createdById], references: [id])
  siteManager User?          @relation("SiteManager", fields: [siteManagerId], references: [id])
  items       HandoverItem[]
  photos      HandoverPhoto[]

  @@map("handovers")
}

model HandoverItem {
  id         String         @id @default(uuid())
  handoverId String         @map("handover_id")
  zoneName   String         @map("zone_name")
  status     String         @default("ok")
  comment    String?
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")
  handover   Handover       @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  photos     HandoverPhoto[]
  itemPhotos HandoverItemPhoto[]

  @@map("handover_items")
}

model HandoverPhoto {
  id           String        @id @default(uuid())
  handoverId   String?       @map("handover_id")
  itemId       String?       @map("item_id")
  uploadedById String?       @map("uploaded_by")
  photoUrl     String        @map("photo_url")
  publicId     String?       @map("public_id")
  caption      String?
  createdAt    DateTime      @default(now()) @map("created_at")
  handover     Handover?     @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  item         HandoverItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("handover_photos")
}

model HandoverItemPhoto {
  id        String       @id @default(cuid())
  itemId    String       @map("item_id")
  item      HandoverItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  photoUrl  String       @map("photo_url")
  publicId  String?      @map("public_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("handover_item_photos")
}

model DailyReport {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  reportDate     DateTime @map("report_date")
  createdById    String?  @map("created_by")
  weather        String?
  workersPresent Int      @default(0) @map("workers_present")
  // Phase du chantier couverte par ce rapport : 'installation' | 'dismantling'.
  // Pilote la liste de tâches par défaut proposée dans le tableau heures/hommes.
  phase          String?
  generalNotes   String?  @map("general_notes")
  sentAt         DateTime? @map("sent_at")
  pdfUrl         String?  @map("pdf_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?                    @relation(fields: [createdById], references: [id])
  entries   DailyReportEntry[]
  checklist DailyReportChecklistItem[]
  photos    DailyReportPhoto[]
  taskHours DailyReportTaskHours[]

  @@map("daily_reports")
}

model DailyReportEntry {
  id          String      @id @default(uuid())
  reportId    String      @map("report_id")
  entryTime   String?     @map("entry_time")
  description String
  createdAt   DateTime    @default(now()) @map("created_at")
  report      DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("daily_report_entries")
}

model DailyReportChecklistItem {
  id        String      @id @default(uuid())
  reportId  String      @map("report_id")
  item      String
  checked   Boolean     @default(false)
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("daily_report_checklist")
}

model DailyReportPhoto {
  id        String      @id @default(uuid())
  reportId  String      @map("report_id")
  photoUrl  String      @map("photo_url")
  publicId  String?     @map("public_id")
  caption   String?
  createdAt DateTime    @default(now()) @map("created_at")
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("daily_report_photos")
}

// Heures + nombre d'hommes saisis directement par tâche sur un rapport journalier.
// Remplace l'ancien système où l'IA devinait ces chiffres à partir du texte libre :
// ici la donnée est exacte dès la saisie, l'IA ne sert plus qu'à rédiger la
// synthèse finale à partir de ces lignes déjà structurées.
model DailyReportTaskHours {
  id             String   @id @default(uuid())
  reportId       String   @map("report_id")
  taskTemplateId String?  @map("task_template_id")
  taskTitle      String   @map("task_title")
  hours          Float    @default(0)
  workers        Int      @default(0)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  report       DailyReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  taskTemplate TaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("daily_report_task_hours")
}

model Ticket {
  id              String        @id @default(uuid())
  projectId       String?       @map("project_id")
  title           String
  description     String
  urgency         TicketUrgency @default(medium)
  status          TicketStatus  @default(open)
  locationOnSite  String?       @map("location_on_site")
  reportedById    String?       @map("reported_by")
  assignedToId    String?       @map("assigned_to")
  plannedDate     DateTime?     @map("planned_date")
  resolvedAt      DateTime?     @map("resolved_at")
  validatedById   String?       @map("validated_by")
  validatedAt     DateTime?     @map("validated_at")
  timeSpent       Float?        @map("time_spent")
  resolutionNotes String?       @map("resolution_notes")
  autoEscalated   Boolean       @default(false) @map("auto_escalated")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  project     Project?        @relation(fields: [projectId], references: [id])
  reportedBy  User?           @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedTo  User?           @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  validatedBy User?           @relation("ValidatedBy", fields: [validatedById], references: [id])
  photos      TicketPhoto[]
  history     TicketHistory[]

  @@map("tickets")
}

model TicketPhoto {
  id           String   @id @default(uuid())
  ticketId     String   @map("ticket_id")
  uploadedById String?  @map("uploaded_by")
  photoUrl     String   @map("photo_url")
  publicId     String?  @map("public_id")
  phase        String   @default("before")
  caption      String?
  createdAt    DateTime @default(now()) @map("created_at")
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_photos")
}

model TicketHistory {
  id          String        @id @default(uuid())
  ticketId    String        @map("ticket_id")
  changedById String?       @map("changed_by")
  oldStatus   TicketStatus? @map("old_status")
  newStatus   TicketStatus? @map("new_status")
  comment     String?
  createdAt   DateTime      @default(now()) @map("created_at")
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_history")
}

model WarehouseBox {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  name          String
  description   String?
  status        BoxStatus @default(preparing)
  qrCode        String?   @unique @map("qr_code")
  preparedById  String?   @map("prepared_by")
  validatedById String?   @map("validated_by")
  validatedAt   DateTime? @map("validated_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preparedBy  User?      @relation("BoxPreparedBy", fields: [preparedById], references: [id])
  validatedBy User?      @relation("BoxValidatedBy", fields: [validatedById], references: [id])
  items       BoxItem[]
  photos      BoxPhoto[]

  @@map("warehouse_boxes")
}

model BoxItem {
  id          String       @id @default(uuid())
  boxId       String       @map("box_id")
  productName String       @map("product_name")
  quantity    Float        @default(1)
  unit        String       @default("pcs")
  description String?
  isPresent   Boolean?     @map("is_present")
  notes       String?
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  box         WarehouseBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@map("box_items")
}

model BoxPhoto {
  id        String       @id @default(uuid())
  boxId     String       @map("box_id")
  photoUrl  String       @map("photo_url")
  publicId  String?      @map("public_id")
  phase     String       @default("content")
  caption   String?
  createdAt DateTime     @default(now()) @map("created_at")
  box       WarehouseBox @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@map("box_photos")
}

model Toolbox {
  id           String          @id @default(uuid())
  name         String
  description  String?
  projectId    String?         @map("project_id")
  qrCode       String?         @unique @map("qr_code")
  status       String          @default("in_warehouse")
  preparedById String?         @map("prepared_by")
  validatedAt  DateTime?       @map("validated_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  project      Project?        @relation(fields: [projectId], references: [id])
  drawers      ToolboxDrawer[]

  @@map("toolboxes")
}

model ToolboxDrawer {
  id          String        @id @default(uuid())
  toolboxId   String        @map("toolbox_id")
  name        String
  sortOrder   Int           @default(0) @map("sort_order")
  photoUrl    String?       @map("photo_url")
  isValidated Boolean       @default(false) @map("is_validated")
  createdAt   DateTime      @default(now()) @map("created_at")
  toolbox     Toolbox       @relation(fields: [toolboxId], references: [id], onDelete: Cascade)
  tools       ToolboxTool[]

  @@map("toolbox_drawers")
}

model ToolboxTool {
  id          String        @id @default(uuid())
  drawerId    String        @map("drawer_id")
  name        String
  expectedQty Int           @default(1) @map("expected_qty")
  actualQty   Int?          @map("actual_qty")
  status      String        @default("ok")
  isChecked   Boolean       @default(false) @map("is_checked")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  drawer      ToolboxDrawer @relation(fields: [drawerId], references: [id], onDelete: Cascade)

  @@map("toolbox_tools")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  data      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model TaskCategory {
  id          String         @id @default(cuid())
  name        String
  description String?
  color       String         @default("#4895ef")
  icon        String         @default("📋")
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  templates   TaskTemplate[]

  @@map("task_categories")
}

model TaskTemplate {
  id            String       @id @default(cuid())
  categoryId    String
  category      TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  durationHours Float        @default(4)
  priority      String       @default("normal")
  // Phase de chantier à laquelle ce template appartient : 'installation' | 'dismantling' | null.
  // Détermine dans quelle liste (Installation / Démontage) la tâche apparaît dans le
  // tableau heures/hommes des rapports journaliers.
  phase         String?
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  dailyReportHours DailyReportTaskHours[]

  @@map("task_templates")
}

model InvitationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  role      String   @default("worker")
  email     String?
  note      String?
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("invitation_tokens")
}

// ─────────────────────────────────────────────
// Remarques / visites client (points de suivi)
// ─────────────────────────────────────────────
model ClientRemark {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  visitId     String?  @map("visit_id")            // FK optionnelle vers ClientVisit
  title       String
  description String?
  zone        String?
  status      String   @default("open")           // open | resolved | urgent | archived
  priority    Priority @default(normal)
  assignedTo  String?  @map("assigned_to")         // FK utilisateur (le front envoie "assignedTo")
  createdBy   String?  @map("created_by")
  resolvedBy  String?  @map("resolved_by")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visit          ClientVisit?        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  assignedToUser User?               @relation("RemarkAssignee", fields: [assignedTo], references: [id])
  photos         ClientRemarkPhoto[]

  @@map("client_remarks")
}

// Une "visite client" = rapport de visite contenant N points (ClientRemark)
model ClientVisit {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  clientId    String?  @map("client_id")
  title       String
  visitDate   DateTime @default(now()) @map("visit_date")
  notes       String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id])
  remarks  ClientRemark[]

  @@map("client_visits")
}

model ClientRemarkPhoto {
  id        String   @id @default(cuid())
  remarkId  String   @map("remark_id")
  remark    ClientRemark @relation(fields: [remarkId], references: [id], onDelete: Cascade)
  photoUrl  String   @map("photo_url")
  publicId  String?  @map("public_id")
  caption   String?
  phase     String?  @default("problem")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("client_remark_photos")
}

// ─────────────────────────────────────────────
// Briefing — document d'avant-événement par projet
// ─────────────────────────────────────────────
model Briefing {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  title        String?
  slides       Json     @default("[]")
  studioSlides Json?    @map("studio_slides")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("briefings")
}

// Plans 2D façon bureau d'études, générés depuis le viewer 3D (planches Fabric.js
// annotées à la main à partir de captures orthographiques — voir plan2d-studio.html).
model Plan2D {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  title       String?
  sheets      Json     @default("[]") // [{ id, name, json, thumbnail }]
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("Plan2DCreatedBy", fields: [createdById], references: [id])

  @@index([projectId])
  @@map("plan2ds")
}

// Module Plans Viewbox : un modèle SketchUp analysé (une version = un fichier, identifié par son SHA-256).
// sceneIndex = index de scène (modules, accessoires, niveaux, avertissements) ; glbUrl = paquet 3D
// normalisé (mm, Y-up, nettoyé) rechargé à chaque ouverture au lieu de réanalyser le .dae.
// Table créée par src/utils/migrations.ts (pas de db push au démarrage sur Railway).
model PlansModelVersion {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  sourceFileId  String?  @map("source_file_id")
  fileName      String   @map("file_name")
  sourceUrl     String?  @map("source_url")
  sha256        String
  sizeBytes     Int?     @map("size_bytes")
  status        String   @default("indexed") // indexed | packaged
  engineVersion String?  @map("engine_version")
  unitMeter     Float?   @map("unit_meter")
  upAxis        String?  @map("up_axis")
  stats         Json     @default("{}")
  warnings      Json     @default("[]")
  sceneIndex    Json?    @map("scene_index")
  glbUrl        String?  @map("glb_url")
  glbPublicId   String?  @map("glb_public_id")
  glbSize       Int?     @map("glb_size")
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("PlansModelCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, sha256])
  @@index([projectId])
  @@map("plans_model_versions")
}
