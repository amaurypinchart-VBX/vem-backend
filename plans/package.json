{
  "name": "vem-plans",
  "private": true,
  "version": "0.1.0",
  "description": "VEM — module Plans Viewbox (modèle SketchUp → jeu de plans d'architecte)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-rbz.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "clipper2-js": "0.9.0",
    "fflate": "0.8.3",
    "immer": "^10.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "three-edge-projection": "github:gkjohnson/three-edge-projection#59a0a452c378",
    "three-mesh-bvh": "0.9.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "three-edge-projection": {
      "three": "$three",
      "three-mesh-bvh": "$three-mesh-bvh"
    }
  }
}
